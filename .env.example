# ============================================================
# campus-gateway 配置样例
# 复制为 .env 后填写。.env 绝不提交仓库。
# 标记 [S1]/[S3]/[S4] 的项需要对应探针做完才能填。
# ============================================================

# ---------- 服务 ----------
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
# gateway 对外的可达地址。GeniOS 工作流的 HTTP 节点要用它回写结果（探针 S5 决定填什么）
GATEWAY_PUBLIC_BASE_URL=http://127.0.0.1:8000

# ---------- 鉴权 ----------
# We-MP-RSS 打 /ingest 时带的共享密钥，请求头 X-Ingest-Secret
INGEST_SHARED_SECRET=change-me-ingest-secret
# GeniOS 工作流打 /opportunities、/validate 时带的共享密钥，请求头 X-Internal-Secret
INTERNAL_SHARED_SECRET=change-me-internal-secret

# ---------- 存储 ----------
DATABASE_URL=sqlite:///./data/campus.db

# ---------- 历史过滤 ----------
# 发布时间早于此值的文章标记 mode=backfill：仍送工作流抽取，但不触发推送
ENABLE_PUSH_AFTER=2026-10-04T00:00:00+08:00

# ---------- GeniOS 流程编排型智能体 API ----------
# ✅ S1 已于 2026-10-07 关闭。下面是**实测确认**的配置形态（南开部署是 HiAgent）：
#   提交：POST {BASE}{PATH}          Apikey: <密钥>
#         {"InputData": "<字符串化JSON>", "UserID": "...", "NoDebug": true}  → 返回 runId
#   查询：POST {BASE}/query_run_app_process
#         {"RunID": "<runId>", "UserID": "..."}  → 返回 status / output
# 📌 注意两个名字的大小写不是一回事：响应里是 runId，查询体里是 RunID。
GENIOS_API_BASE_URL=
GENIOS_API_PATH=
GENIOS_APP_ID=
GENIOS_API_KEY=
# 鉴权方式：bearer | header | body（本部署实测用 header）
GENIOS_AUTH_MODE=header
# 当 GENIOS_AUTH_MODE=header 时，密钥放在哪个请求头上
GENIOS_API_KEY_HEADER=Apikey
# 鉴权字段名（AUTH_MODE=body 时用），以及是否把密钥原样放入还是加 Bearer 前缀
GENIOS_API_KEY_PREFIX=
# 提交时带的用户标识（HiAgent 要求每次调用带 UserID，查询时也要带同一个）
GENIOS_USER_ID=campus-gateway
# 请求体模板（JSON）。可用 {payload_json} {app_id} {api_key} {user_id} 占位，
# 每个占位符会被替换成**已经带引号转义好的 JSON 字符串字面量**，模板里不要再加引号：
#   ✅ {"appId": "{app_id}", "input": {payload_json}}
#   ❌ {"appId": "{app_id}", "input": "{payload_json}"}
# 实测：InputData 必须是**字符串**，而 {payload_json} 正好渲染成带引号转义的字面量。
GENIOS_REQUEST_TEMPLATE=
# 查询异步结果的请求体模板。实测：要 **POST + body**，不是 GET。
GENIOS_QUERY_TEMPLATE={"RunID": {task_id}, "UserID": {user_id}}
# 异步任务轮询
# TASK_ID_FIELD 是提交**响应**里取任务 ID 的字段名（runId，小写 r）
GENIOS_TASK_ID_FIELD=runId
# STATUS_PATH 是查询端点；留空则不轮询（就取不到 GeniOS 的执行结果）
GENIOS_STATUS_PATH=
# TASK_ID_PATH 是按点号路径取值的高级写法，一般留空，用 TASK_ID_FIELD 即可
GENIOS_TASK_ID_PATH=
GENIOS_POLL_INTERVAL_SECONDS=3
GENIOS_POLL_MAX_SECONDS=180
GENIOS_TIMEOUT_SECONDS=120
# 没有真实凭据时置 1：worker 只记录不真调，便于本地跑通链路
GENIOS_DRY_RUN=1

# ---------- worker ----------
WORKER_CONCURRENCY=2
WORKER_MAX_ATTEMPTS=4
WORKER_BACKOFF_BASE_SECONDS=2
WORKER_POLL_INTERVAL_SECONDS=5

# ---------- 飞书 ----------
# 机会推送群（自定义机器人 Webhook）
FEISHU_OPPORTUNITY_WEBHOOK_URL=
FEISHU_OPPORTUNITY_WEBHOOK_SECRET=
# 运维告警群，必须与上面分开
FEISHU_ALERT_WEBHOOK_URL=
FEISHU_ALERT_WEBHOOK_SECRET=
# 频控（自定义机器人约 100 次/分钟，保守取 80）
FEISHU_RATE_LIMIT_PER_MINUTE=80

# ---------- 飞书自建应用（推送通道）----------
# 为什么用自建应用而不是群自定义机器人：本服务最终跑在校内网、被飞连挡着，
# 自建应用这条通道已验证可行（docs/findings.md S6），不必再维护第二套密钥。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 推送目标：open_id（ou_…，发给某个人）或 chat_id（oc_…，发给某个群）
FEISHU_NOTIFY_TARGET=
# 打开后 worker 取回 GeniOS 结果就会推送。改 0 即关（默认关，避免误发）
FEISHU_APP_PUSH_ENABLED=0

# ---------- 存活监控 ----------
# 超过这么久没收到任何 /ingest 就告警
ALERT_IF_NO_INGEST_MINUTES=180

# ---------- 读写权限 ----------
# GET /opportunities 是否强制鉴权。默认 0（校内只读）；对外暴露时建议置 1
REQUIRE_AUTH_FOR_GET=0

# ---------- 调试 ----------
# 未识别的原始载荷落盘目录（探针 S3 用）
DEBUG_CAPTURE_DIR=./data/captures
# /_debug/echo 与 /ingest/_debug 是**免鉴权**的（GeniOS 的 HTTP 节点不会带我们的密钥，探针必须能打到）。
# ⚠️ 对外长期暴露前必须置 0
DEBUG_ENDPOINTS_ENABLED=1

# ---------- We-MP-RSS（docker-compose 用）----------
WEMP_RSS_PORT=8001
WEMP_RSS_DATA_DIR=./data/we-mp-rss
# 消息任务推送到 gateway 的地址（容器内互访）
WEMP_RSS_WEBHOOK_TARGET=http://gateway:8000/ingest/_debug

# ============================================================
# 功能模块二 · 组队匹配（见 docs/module2_team_matching.md）
# ============================================================

# ---------- 多维表格（业务数据的事实源，决策 D9）----------
# ⚠️ 走的是**应用身份**（tenant_access_token），所以自建应用必须：
#   ① 在开放平台开通 bitable 权限（bitable:app 或 base:table:read + base:record:retrieve）
#   ② 被加为目标多维表格的协作者
# 没开通时报 99991672，错误信息里会带申请链接。
BITABLE_ENABLED=0
# 多维表格的 app_token（表 URL 里 /base/ 后面那段）
BITABLE_APP_TOKEN=
# 三张表的 table_id（形如 tbl…）
BITABLE_REQUEST_TABLE_ID=
BITABLE_PROFILE_TABLE_ID=
BITABLE_INVITE_TABLE_ID=
# 机会汇总（模块一的产出 —— D9 之后**只写这里**，不再进 SQLite）
BITABLE_OPPORTUNITY_TABLE_ID=

# ---------- 匹配工作流（模块二的第二个 GeniOS 智能体）----------
# 模块一那个工作流用上面的 GENIOS_*；这一组只覆盖"这个工作流是谁、怎么调"，
# base_url / 鉴权方式 / 超时沿用 GENIOS_*。
GENIOS_MATCH_ENABLED=0
GENIOS_MATCH_API_KEY=
GENIOS_MATCH_API_PATH=/api/proxy/api/v1/run_app_workflow
GENIOS_MATCH_STATUS_PATH=/api/proxy/api/v1/query_run_app_process
GENIOS_MATCH_TASK_ID_FIELD=runId
GENIOS_MATCH_USER_ID=campus-gateway
GENIOS_MATCH_REQUEST_TEMPLATE={"InputData": {payload_json}, "UserID": {user_id}, "NoDebug": true}
GENIOS_MATCH_QUERY_TEMPLATE={"RunID": {task_id}, "UserID": {user_id}}
# 没有真实凭据时置 1：只记录不真调
GENIOS_MATCH_DRY_RUN=1

# 轮询【组队需求】的间隔（秒）
MATCH_POLL_INTERVAL_SECONDS=30
# 匹配结果取前几名
MATCH_TOP_N=3


# ---------- 对话智能体（对话型 / 对话流型）----------
# ⚠️ 和上面的 GENIOS_* 是**两族完全不同的 API**：
#   GENIOS_*        → 流程编排型：run_app_workflow，单轮、异步
#   GENIOS_CHAT_*   → 对话型：create_conversation + chat_query，多轮、SSE 流式
# 端点是从平台探出来的，见 docs/findings.md Q11。
GENIOS_CHAT_ENABLED=0
GENIOS_CHAT_API_KEY=
# ⚠️ 对话智能体的「服务身份」，**不要填学生 open_id**。
# 插件 OAuth 授权按 userID 绑定 —— 传学生 id 的话每个新同学都要授权一次。
GENIOS_CHAT_USER_ID=campus-gateway

# ---------- 表单链接（发出去之前会按人预填姓名）----------
# ⚠️ 链接里**不要**带查询串之外的东西。预填由 `app/forms.py` 拼 `?prefill_姓名=…`。
FEISHU_PROFILE_FORM_URL=https://nankai.feishu.cn/share/base/shrcnrNj3Dh5T7ce4OxZUO3huBf
FEISHU_REQUEST_FORM_URL=https://nankai.feishu.cn/share/base/shrcnH1oQRYtBvm1y7WYAj38gne
# 表单视图 id（调题目顺序用，见 scripts/reorder_form_fields.py）
BITABLE_PROFILE_FORM_ID=vew7DJ6XWV
BITABLE_REQUEST_FORM_ID=vewKiZYw3f
